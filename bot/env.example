# Required. From @BotFather.
BOT_TOKEN=

# Optional. Public https origin of this Railway service, no trailing slash.
# Example: https://reeldrop-production.up.railway.app
# If empty, the bot uses long polling.
WEBHOOK_URL=

# Optional. Comma-separated Telegram user ids. Empty = public.
ALLOWED_USER_IDS=

# Optional. Custom Telegram Bot API server URL (e.g. your Railway Docker service).
# Unlocks 2 GB uploads directly through the Bot API without 50 MB limits.
# Example: https://telegram-bot-api-production.up.railway.app
# Or Railway internal private URL: http://telegram-bot-api.railway.internal:8081
TELEGRAM_API_ROOT=

# Telegram bot upload cap in MB.
# Default is 49 MB on public api.telegram.org.
# Automatically raised to 1900 MB when TELEGRAM_API_ROOT or MTProto credentials are set.
MAX_FILE_MB=49

# Skip very long videos (seconds).
MAX_DURATION_SEC=7800

# Parallel yt-dlp jobs on this dyno.
CONCURRENCY=2

DOWNLOAD_TIMEOUT_MS=180000

# Netscape cookies.txt, base64-encoded. Useful for Instagram / age-gated YouTube.
# COOKIES_B64=

# Or mount a file and point at it.
# COOKIES_FILE=/app/cookies.txt


TG_API_ID=33524999
 TG_API_HASH=3ff16efb81196031253501bdd54bafe6


TG_